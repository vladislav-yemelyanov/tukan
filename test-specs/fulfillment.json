  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "required": [
          "nextCursor",
          "hasMore"
        ],
        "properties": {
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "previousCursor": {
            "type": "string",
            "nullable": true
          },
          "hasMore": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Address": {
        "type": "object",
        "required": [
          "line1",
          "city",
          "postalCode",
          "country"
        ],
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "nullable": true
          },
          "postalCode": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "UAH"
            ]
          }
        },
        "additionalProperties": false
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "action",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "nullable": true
          },
          "action": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "changes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "before",
                "after"
              ],
              "properties": {
                "before": {},
                "after": {}
              }
            }
          }
        }
      },
      "FileContent": {
        "type": "string",
        "format": "binary"
      },
      "Metadata": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "OrderState": {
        "type": "string",
        "enum": [
          "placed",
          "confirmed",
          "allocated",
          "shipped",
          "delivered",
          "canceled"
        ]
      },
      "OrderLine": {
        "type": "object",
        "required": [
          "id",
          "sku",
          "quantity",
          "unitPrice"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unitPrice": {
            "$ref": "#/components/schemas/Money"
          },
          "attributes": {
            "$ref": "#/components/schemas/Metadata"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "customerId",
          "state",
          "lines",
          "total",
          "shippingAddress"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/OrderState"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "billingAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "shipments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Shipment"
            }
          },
          "notes": {
            "type": "string",
            "nullable": true
