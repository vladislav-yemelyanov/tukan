{
  "name": "tukan",
  "version": "0.1.1",
  "description": "Zero-dependency, schema-typed fetch HTTP client for Tukan-generated TypeScript OpenAPI types.",
  "license": "MIT",
  "author": "Vladislav Yemelyanov",
  "homepage": "https://github.com/vladislav-yemelyanov/tukan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladislav-yemelyanov/tukan.git",
    "directory": "clients/ts"
  },
  "bugs": {
    "url": "https://github.com/vladislav-yemelyanov/tukan/issues"
  },
  "keywords": [
    "tukan",
    "openapi",
    "http",
    "client",
    "fetch",
    "typescript",
    "typed"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build",
    "test": "bash ../../scripts/check-ts-client.sh"
  }
}
